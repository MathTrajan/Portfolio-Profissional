# Config do servidor que entrega este site. O script de publicacao a instala em
# /etc/caddy/Caddyfile, valida e recarrega -- editar no servidor a mao e perder
# a edicao no proximo deploy.
#
# O site e estatico e nao tem build: o Caddy so entrega os arquivos. Este
# arquivo guarda os headers de seguranca e a politica de cache, que antes
# viviam no vercel.json e depois na imagem do container.
{
	# O TLS termina na borda da Cloudflare e o cloudflared entrega aqui em
	# http no loopback. Sem isto o Caddy tentaria emitir certificado proprio
	# para um hostname que ele nao controla.
	auto_https off

	# Fecha a API de administracao, que por padrao escuta em 127.0.0.1:2019 e
	# reconfigura o servidor inteiro sem autenticacao.
	#
	# ⚠️ Com isto `systemctl reload caddy` NAO funciona: o `caddy reload` envia
	# a config nova justamente por essa API e falha com connection refused na
	# 2019. Aplicar mudanca neste arquivo exige `systemctl restart caddy`, que
	# e o que o script de publicacao faz. A falha do reload nao derruba o
	# processo, so nao aplica nada -- entao o arquivo em disco pode divergir do
	# que esta valendo em memoria.
	admin off
}

:3700 {
	# So o loopback: quem expoe para a internet e o Cloudflare Tunnel, e
	# porta aberta em interface externa seria caminho paralelo sem TLS.
	bind 127.0.0.1

	# www -> apex, 308 para preservar o metodo. Fica aqui e nao numa Redirect
	# Rule do painel da Cloudflare porque assim a regra e versionada junto do
	# site, em vez de viver num estado de dashboard que ninguem le.
	@www host www.trajano.tech
	redir @www https://trajano.tech{uri} 308

	# ⚠️ A landing de captacao (~/Dev/Landing-Servicos) e servida em
	# /sistemas pelo MESMO Caddy, de proposito: assim ela nao precisa de
	# CNAME proprio, e o apiToken do cert.pem do tunel so enxerga outra
	# zona -- hostname novo em trajano.tech exigiria registro criado a
	# mao no painel.
	#
	# Mora neste arquivo porque o Caddy le UM Caddyfile e o
	# deploy-portfolio.sh o sobrescreve: um bloco em /etc/caddy/conf.d seria
	# apagado no proximo deploy do portfolio. Quem publica a landing e
	# ~/Dev/Sentinel/scripts/deploy-landing.sh, que mexe so em /opt/landing.
	#
	# Sem a barra final os caminhos relativos da landing (vendor/, favicon)
	# resolveriam na RAIZ e cairiam no portfolio, dando 404 calado.
	redir /sistemas /sistemas/ 308
	handle_path /sistemas/* {
		root * /opt/landing
		encode zstd gzip
		file_server
		header Cache-Control "public, max-age=0, must-revalidate"
	}

	root * /opt/portfolio
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
		-Server
	}

	# As capas .svg sao REGENERADAS por tools/gerar-capas.py e o nome do
	# arquivo nao tem hash. Cache immutable deixaria o visitante recorrente
	# preso a uma capa antiga ate o cache expirar, entao o navegador sempre
	# revalida -- um 304 custa quase nada para um arquivo de 14 KB.
	#
	# ⚠️ Formato novo servido pelo site entra NESTA lista. A foto virou .webp
	# e .jpg em 09/10/2026 e, sem a extensao aqui, sairia sem Cache-Control
	# nenhum -- o que nao quebra nada visivelmente e so aparece no DevTools.
	@assets path *.svg *.png *.ico *.webp *.jpg
	header @assets Cache-Control "public, max-age=0, must-revalidate"

	# Precisa casar "/" e "/index.html": o file_server resolve a raiz para o
	# index, mas o matcher de path compara a URL pedida, nao o arquivo
	# entregue -- so "/index.html" deixava a home sem Cache-Control.
	@html path / /index.html
	header @html Cache-Control "public, max-age=0, must-revalidate"

	log {
		output stdout
		format console
	}
}
